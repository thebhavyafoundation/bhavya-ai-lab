---
interface Props {
  href?: string;
  class?: string;
}
const { href, class: className = '' } = Astro.props;
const base =
  'block rounded-lg border border-border bg-surface p-5 shadow-soft transition-shadow duration-fast hover:shadow-card focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---
{href ? (
  <a href={href} class={`${base} ${className}`}>
    <slot />
  </a>
) : (
  <div class={`${base} ${className}`}>
    <slot />
  </div>
)}
