---
import Container from '../layout/Container.astro';

const nav = [
  { href: '/about', label: 'About' },
  { href: '/learn', label: 'Learn' },
  { href: '/projects', label: 'Projects' },
  { href: '/experiments', label: 'Experiments' },
  { href: '/research', label: 'Research' },
  { href: '/resources', label: 'Resources' },
  { href: '/join', label: 'Join' },
];

const pathname = Astro.url.pathname;
---
<header class="border-b border-border bg-surface/95 backdrop-blur-sm sticky top-0 z-40">
  <Container class="flex items-center justify-between gap-4 h-14">
    <a href="/" class="font-semibold text-ink no-underline hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
      Bhavya AI Lab
    </a>
    <nav class="hidden md:flex items-center gap-6" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-small no-underline hover:text-accent',
            pathname === item.href || pathname.startsWith(item.href + '/')
              ? 'text-accent font-medium'
              : 'text-ink-secondary',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer text-small text-ink-secondary px-2 py-1 rounded-md border border-border focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
        Menu
      </summary>
      <nav class="absolute right-0 mt-2 w-48 rounded-md border border-border bg-surface shadow-card p-2 flex flex-col gap-1" aria-label="Mobile primary">
        {nav.map((item) => (
          <a
            href={item.href}
            class="block px-3 py-2 text-small text-ink-secondary no-underline rounded-sm hover:bg-bg-alt hover:text-accent"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </Container>
</header>
